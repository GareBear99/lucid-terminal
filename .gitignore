# Dependencies
node_modules/
# NOTE: package-lock.json is intentionally TRACKED (see .github/workflows/test.yml):
# `npm ci` needs it, so installs are reproducible.
yarn.lock

# Build outputs
dist/
build/
out/
*.js
*.js.map
*.d.ts
!electron/**/*.js
# Vendored Monaco bundle (public/monaco/vs) — shipped with the app so the
# editor works with no CDN. Keep it in git; re-copy it on monaco upgrades.
!public/monaco/**
# Vendored v67 synth shell siblings (public/synth/arc_*.js) — kept in
# git so the synth test passes in CI (the blanket *.js above would
# otherwise ignore them).
!public/synth/arc_*.js

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log
logs/

# FixNet data (root-anchored: only a top-level data dir — NOT the
# electron/core/fixnet/ source module, which must be committed)
/fixnet/
.fixnet/
*.fixnet

# Testing
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp
typecheck_error*.txt

# Build artifacts that exceed GitHub limits
*.dmg
*.zip
*.app/
Electron Framework
dist/mac/
dist/mac-arm64/
release/
out/mac/
out/mac-arm64/
LUCID-BACKEND/Lucid Terminal.app/
